# PulseGuard Root Environment Configuration Example

# Backend API Configuration
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=pulseguard-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (defaults to local SQLite if unset, or PostgreSQL/Supabase URL in production)
DATABASE_URL=sqlite:///./pulseguard.db
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Machine Learning & Audio Configuration
MODEL_PATH=backend/app/ml/artifacts/cae_fan_model.pt
KNN_INDEX_PATH=backend/app/ml/artifacts/knn_reference_bank.pkl
THRESHOLDS_CONFIG_PATH=backend/app/ml/artifacts/calibrated_thresholds.json
MAX_UPLOAD_SIZE_MB=15

# IoT Simulator Configuration
SIMULATOR_TICK_SECONDS=2
IOT_API_KEY=pulseguard-iot-device-secret-key-demo-2026

# Frontend Environment Variables (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_BASE_URL=ws://localhost:8000
